@torch.no_grad()
def make_tau_lambda_diagnostic(cfg: SimCfg, device, out_dir: str, L: int = 100, mc: int = 256):
    """
    Old scalar-only mapping should give almost zero SINR difference when tau/Lambda change.
    Revised mapping should give nonzero difference because tau/Lambda modify a_rob.
    """
    batch = gen_scene_batch_revision(cfg, mc, L, 10.0, device, array_type="ula", error_type="angle")

    B, N, _ = batch["Rhat"].shape
    rho = torch.full((B,), 0.1, device=device)
    tau_1 = torch.zeros(B, device=device)
    tau_2 = torch.full((B,), 10.0, device=device)
    lam_1 = torch.ones(B, N, device=device)
    lam_2 = torch.linspace(0.05, 5.0, N, device=device)[None, :].expand(B, -1)

    w_old_1 = robust_beamformer_scaling_only_old(batch["Rhat"], batch["bar_a"], tau_1, rho, lam_1)
    w_old_2 = robust_beamformer_scaling_only_old(batch["Rhat"], batch["bar_a"], tau_2, rho, lam_2)
    s_old_1 = sinr_out_db(w_old_1, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])
    s_old_2 = sinr_out_db(w_old_2, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])

    w_new_1 = robust_beamformer_from_params(batch["Rhat"], batch["bar_a"], tau_1, rho, lam_1)
    w_new_2 = robust_beamformer_from_params(batch["Rhat"], batch["bar_a"], tau_2, rho, lam_2)
    s_new_1 = sinr_out_db(w_new_1, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])
    s_new_2 = sinr_out_db(w_new_2, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])

    rows = [
        ["Old scalar-only mapping", "max |ΔSINR|", float((s_old_1 - s_old_2).abs().max().cpu())],
        ["Old scalar-only mapping", "mean |ΔSINR|", float((s_old_1 - s_old_2).abs().mean().cpu())],
        ["Revised steering-perturb mapping", "max |ΔSINR|", float((s_new_1 - s_new_2).abs().max().cpu())],
        ["Revised steering-perturb mapping", "mean |ΔSINR|", float((s_new_1 - s_new_2).abs().mean().cpu())],
    ]

    write_csv(
        os.path.join(out_dir, "table_tau_lambda_diagnostic.csv"),
        ["mapping", "metric", "value"],
        rows,
    )

    body = [[r[0], r[1], f"{r[2]:.6g}"] for r in rows]
    write_tex_table(
        os.path.join(out_dir, "table_tau_lambda_diagnostic.tex"),
        caption="Diagnostic of tau and Lambda effects on output SINR.",
        label="tab:tau_lambda_diagnostic",
        colspec="llc",
        header_lines=["Mapping & Metric & Value \\\\"],
        body_lines=[f"{r[0]} & {r[1]} & {r[2]} \\\\" for r in body],
        notes="Old scalar-only mapping changes only the beamformer scale, whereas the revised mapping changes the robust steering vector.",
    )


