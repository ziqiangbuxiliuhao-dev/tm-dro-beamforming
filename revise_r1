    key = canonical_method_name(name)
    style = METHOD_STYLE.get(key, None)

    if style is not None:
        return style

    # Fallback for unexpected method names
    fallback_colors = [
        "#4E79A7", "#F28E2B", "#E15759", "#76B7B2",
        "#59A14F", "#EDC948", "#B07AA1", "#FF9DA7",
        "#9C755F", "#BAB0AC",
    ]
    idx = abs(hash(key)) % len(fallback_colors)
    return {
        "color": fallback_colors[idx],
        "marker": "o",
        "linestyle": "-",
        "linewidth": 2.1,
    }


def sort_curve_items(curves: Dict[str, List[float]]):
    return sorted(
        curves.items(),
        key=lambda kv: (
            METHOD_RANK.get(canonical_method_name(kv[0]), 999),
            canonical_method_name(kv[0])
        )
    )


def plot_professional_lines(
    curves: Dict[str, List[float]],
    x_list: List[float],
    xlabel: str,
    ylabel: str,
    out_base: str,
    title: str = None,
    ylim=None,
):
    set_pub_style()

    # Slightly wider figure because the legend has many methods
    fig, ax = plt.subplots(figsize=(7.2, 4.8))

    for name, y in sort_curve_items(curves):
        y = np.asarray(y, dtype=np.float64)
        if len(y) != len(x_list):
            continue

        st = get_method_style(name)

        ax.plot(
            x_list,
            y,
            label=name,
            color=st["color"],
            linestyle=st["linestyle"],
            marker=st["marker"],
            linewidth=st["linewidth"],
            markersize=5.8 if canonical_method_name(name) != "Proposed TM-DRO" else 7.8,
            markerfacecolor=st["color"],
            markeredgecolor="white",
            markeredgewidth=0.55,
            markevery=1,
        )

    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)

    if title is not None:
        ax.set_title(title)

    if ylim is not None:
        ax.set_ylim(ylim)

    apply_axis_style(ax)

    # Professional compact legend
    handles, labels = ax.get_legend_handles_labels()
    leg = ax.legend(
        handles,
        labels,
        loc="upper center",
        bbox_to_anchor=(0.5, -0.23),
        ncol=4,
        frameon=True,
        fancybox=False,
        fontsize=7.4,
        handlelength=2.1,
        columnspacing=1.1,
        handletextpad=0.45,
        borderaxespad=0.0,
    )
    leg.get_frame().set_linewidth(0.7)
    leg.get_frame().set_alpha(0.96)

    fig.subplots_adjust(bottom=0.34)
    savefig_dual(out_base)
