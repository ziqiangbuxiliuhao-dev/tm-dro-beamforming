import time


# ---------------------------------------------------------
# 0) Replace the original robust_beamformer_from_params
# ---------------------------------------------------------
def robust_beamformer_from_params(Rhat, bar_a, tau, rho, lam_diag, eps_max: float = 0.25) -> torch.Tensor:
    """
    Revised robust mapping.

    Why this replacement is necessary:
    The old mapping used w = alpha * v, where tau and Lambda mainly changed alpha.
    Output SINR is scale-invariant to alpha, so tau and Lambda had almost no effect on SINR.
    Here tau and Lambda perturb the robust steering vector itself:
        R_rho = Rhat + rho I
        v = R_rho^{-1} bar_a
        d = normalize(v / sqrt(lambda))
        a_rob = normalize(bar_a - eta(tau) d)
        w = MVDR(R_rho, a_rob)

    Therefore tau and Lambda affect the beampattern and the output SINR.
    """
    B, N, _ = Rhat.shape
    dtype = Rhat.dtype
    I = cplx_eye(N, Rhat.device, dtype=dtype)[None].expand(B, -1, -1)

    Rrho = Rhat + rho[:, None, None].to(dtype) * I
    v = solve(Rrho, bar_a)

    d = v / torch.sqrt(lam_diag.clamp_min(1e-6)).to(dtype)
    d = d / torch.linalg.norm(d, dim=-1, keepdim=True).clamp_min(1e-12)

    eta = eps_max * (tau / (1.0 + tau)).clamp(0.0, 1.0)
    a_rob = bar_a - eta[:, None].to(dtype) * d
    a_rob = a_rob / torch.linalg.norm(a_rob, dim=-1, keepdim=True).clamp_min(1e-12)

    return mvdr_weight(Rrho, a_rob)


def robust_beamformer_scaling_only_old(Rhat, bar_a, tau, rho, lam_diag) -> torch.Tensor:
    """
    Old diagnostic-only version:
    tau and Lambda only enter alpha, so output SINR should be invariant.
    Keep this only for the reviewer diagnostic table.
    """
    B, N, _ = Rhat.shape
    dtype = Rhat.dtype
    I = cplx_eye(N, Rhat.device, dtype=dtype)[None].expand(B, -1, -1)

    Rl = Rhat + rho[:, None, None].to(dtype) * I
    v = solve(Rl, bar_a)

    vhb = (torch.conj(v) * bar_a).sum(dim=-1).real
    inv_lam = 1.0 / lam_diag.clamp_min(1e-6)
    maha = torch.sqrt((abs2(v) * inv_lam).sum(dim=-1).clamp_min(1e-12))
    denom = F.softplus(vhb - tau * maha) + 1e-6
    alpha = 1.0 / denom
    return v * alpha[:, None].to(dtype)


# ---------------------------------------------------------
# 1) Generic array geometry: ULA, UCA, CCAA
# ---------------------------------------------------------
def array_positions_2d(N: int, d_over_lambda: float, array_type: str, device) -> torch.Tensor:
    """
    Return 2D sensor positions in wavelength units, shape [N, 2].
    array_type: "ula", "uca", or "ccaa".
    """
    array_type = array_type.lower()

    if array_type == "ula":
        x = (torch.arange(N, device=device, dtype=torch.float32) - (N - 1) / 2.0) * d_over_lambda
        y = torch.zeros_like(x)
        return torch.stack([x, y], dim=-1)

    if array_type == "uca":
        radius = max(d_over_lambda, N * d_over_lambda / (2.0 * math.pi))
        phi = 2.0 * math.pi * torch.arange(N, device=device, dtype=torch.float32) / N
        x = radius * torch.cos(phi)
        y = radius * torch.sin(phi)
        return torch.stack([x, y], dim=-1)

    if array_type == "ccaa":
        # Simple concentric circular antenna array: inner ring + outer ring.
        n1 = N // 2
        n2 = N - n1
        r1 = max(d_over_lambda, n1 * d_over_lambda / (2.0 * math.pi))
        r2 = 1.8 * r1

        phi1 = 2.0 * math.pi * torch.arange(n1, device=device, dtype=torch.float32) / max(1, n1)
        phi2 = 2.0 * math.pi * (torch.arange(n2, device=device, dtype=torch.float32) + 0.5) / max(1, n2)

        p1 = torch.stack([r1 * torch.cos(phi1), r1 * torch.sin(phi1)], dim=-1)
        p2 = torch.stack([r2 * torch.cos(phi2), r2 * torch.sin(phi2)], dim=-1)
        return torch.cat([p1, p2], dim=0)

    raise ValueError("array_type must be 'ula', 'uca', or 'ccaa'.")


def steering_from_positions(pos: torch.Tensor, theta_deg: torch.Tensor, device, dtype=torch.complex64) -> torch.Tensor:
    """
    Far-field steering vector from 2D positions.
    theta is measured from the broadside of the ULA.
    pos: [N, 2]
    theta_deg: [B]
    return: [B, N]
    """
    theta = theta_deg.to(device=device, dtype=torch.float32) * math.pi / 180.0
    ux = torch.sin(theta)[:, None]
    uy = torch.cos(theta)[:, None]

    phase = 2.0 * math.pi * (ux * pos[None, :, 0] + uy * pos[None, :, 1])
    a = torch.exp(1j * phase.to(torch.complex64))
    a = a / torch.linalg.norm(a, dim=-1, keepdim=True).clamp_min(1e-12)
    return a.to(dtype)


def steering_from_batch_positions(pos_b: torch.Tensor, theta_deg: torch.Tensor, dtype=torch.complex64) -> torch.Tensor:
    """
    Batch-specific positions.
    pos_b: [B, N, 2]
    theta_deg: [B]
    return: [B, N]
    """
    theta = theta_deg.to(device=pos_b.device, dtype=torch.float32) * math.pi / 180.0
    ux = torch.sin(theta)[:, None]
    uy = torch.cos(theta)[:, None]

    phase = 2.0 * math.pi * (ux * pos_b[:, :, 0] + uy * pos_b[:, :, 1])
    a = torch.exp(1j * phase.to(torch.complex64))
    a = a / torch.linalg.norm(a, dim=-1, keepdim=True).clamp_min(1e-12)
    return a.to(dtype)


def normalize_complex_vec(a: torch.Tensor) -> torch.Tensor:
    return a / torch.linalg.norm(a, dim=-1, keepdim=True).clamp_min(1e-12)


def apply_gain_phase_error(a: torch.Tensor, amp: torch.Tensor, phase: torch.Tensor) -> torch.Tensor:
    """
    a: [B,N] or [B,N,K]
    amp, phase: [B,N]
    """
    g = amp * torch.exp(1j * phase.to(torch.complex64))
    if a.ndim == 2:
        return normalize_complex_vec(a * g)
    return normalize_complex_vec(a * g[:, :, None])


def add_random_sv_error(a: torch.Tensor, eps: float) -> torch.Tensor:
    z = sample_complex_gaussian(a.shape, a.device, dtype=a.dtype)
    z = z / torch.linalg.norm(z, dim=-1, keepdim=True).clamp_min(1e-12)
    return normalize_complex_vec(a + eps * z)


# ---------------------------------------------------------
# 2) Scene generator with non-angle errors
# ---------------------------------------------------------
@torch.no_grad()
def gen_scene_batch_revision(
    cfg: SimCfg,
    B: int,
    L: int,
    snr_db,
    device,
    array_type: str = "ula",
    error_type: str = "angle",
    gain_amp_std: float = 0.08,
    gain_phase_std_deg: float = 6.0,
    pos_std_lambda: float = 0.03,
    rand_sv_eps: float = 0.08,
) -> Dict[str, torch.Tensor]:
    """
    error_type:
      - "angle": DOA mismatch only
      - "gain_phase": element gain/phase error
      - "position": sensor position error
      - "random_sv": random steering-vector perturbation
      - "combined": all above
      - "none": no mismatch
    """
    N = cfg.N
    dtype = torch.complex64

    if not torch.is_tensor(snr_db):
        snr_db = torch.full((B,), float(snr_db), device=device, dtype=torch.float32)
    else:
        snr_db = snr_db.to(device=device, dtype=torch.float32)
        if snr_db.numel() == 1:
            snr_db = snr_db.expand(B)

    pos_nom = array_positions_2d(N, cfg.d_over_lambda, array_type, device)
    pos_true = pos_nom[None, :, :].expand(B, -1, -1).clone()

    if error_type in ["position", "combined"]:
        pos_true = pos_true + pos_std_lambda * torch.randn(B, N, 2, device=device)

    theta_nom = torch.full((B,), float(cfg.theta_s_nom_deg), device=device, dtype=torch.float32)
    theta_true = theta_nom.clone()

    if error_type in ["angle", "combined"]:
        theta_true = theta_true + cfg.mismatch_std_deg * torch.randn(B, device=device)

    a_nom = steering_from_positions(pos_nom, theta_nom, device, dtype=dtype)
    a_true = steering_from_batch_positions(pos_true, theta_true, dtype=dtype)

    a_j_list = []
    for th in cfg.theta_js_deg:
        th_vec = torch.full((B,), float(th), device=device, dtype=torch.float32)
        a_j_list.append(steering_from_batch_positions(pos_true, th_vec, dtype=dtype))
    A_j = torch.stack(a_j_list, dim=-1)

    if error_type in ["gain_phase", "combined"]:
        amp = 1.0 + gain_amp_std * torch.randn(B, N, device=device)
        phase = (gain_phase_std_deg * math.pi / 180.0) * torch.randn(B, N, device=device)
        a_true = apply_gain_phase_error(a_true, amp, phase)
        A_j = apply_gain_phase_error(A_j, amp, phase)

    if error_type in ["random_sv", "combined"]:
        a_true = add_random_sv_error(a_true, rand_sv_eps)

    # bar_a is still obtained from nominal uncertainty samples.
    M = cfg.a_samples_M
    theta_samples = (
        torch.tensor(cfg.theta_s_nom_deg, device=device, dtype=torch.float32)[None, None]
        + torch.randn(B, M, device=device, dtype=torch.float32) * cfg.mismatch_std_deg
    )
    a_samps = steering_from_positions(pos_nom, theta_samples.reshape(-1), device, dtype=dtype).reshape(B, M, N)
    bar_a = a_samps.mean(dim=1)
    bar_a = bar_a / torch.linalg.norm(bar_a, dim=-1, keepdim=True).clamp_min(1e-12)

    snr_lin = 10.0 ** (snr_db / 10.0)
    sigma_s2 = snr_lin * cfg.noise_var
    sigma_s = torch.sqrt(sigma_s2).to(torch.float32)

    inr_lin = 10.0 ** (cfg.INR_dB / 10.0)
    sigma_i2 = inr_lin * cfg.noise_var

    I = cplx_eye(N, device, dtype=dtype).unsqueeze(0).expand(B, -1, -1)
    Rin_true = cfg.noise_var * I
    for k in range(A_j.shape[-1]):
        aj = A_j[:, :, k]
        Rin_true = Rin_true + sigma_i2 * (aj[:, :, None] * torch.conj(aj[:, None, :]))
    Rin_true = hermitize(Rin_true)

    s = sample_complex_gaussian((B, L), device, dtype=dtype) * sigma_s[:, None].to(dtype)
    X = a_true[:, :, None] * s[:, None, :]

    for k in range(A_j.shape[-1]):
        u = sample_complex_gaussian((B, L), device, dtype=dtype) * math.sqrt(sigma_i2)
        X = X + A_j[:, :, k][:, :, None] * u[:, None, :]

    n = sample_complex_gaussian((B, N, L), device, dtype=dtype) * math.sqrt(cfg.noise_var)
    X = X + n

    Rhat = (X @ torch.conj(X.transpose(-1, -2))) / float(L)
    Rhat = hermitize(Rhat)

    return {
        "Rhat": Rhat,
        "Rin_true": Rin_true,
        "a_true": a_true,
        "a_nom": a_nom,
        "bar_a": bar_a,
        "A_j": A_j,
        "sigma_s2": sigma_s2.to(torch.float32),
        "pos_nom": pos_nom,
        "array_type": array_type,
        "error_type": error_type,
    }


