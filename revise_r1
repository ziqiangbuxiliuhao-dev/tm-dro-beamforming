@torch.no_grad()
@torch.no_grad()
def make_complexity_latency_revision(
    cfg: SimCfg,
    device,
    out_dir: str,
    models: Dict[str, nn.Module],
    batch_size: int = 256,
    L: int = 100,
    repeat: int = 30,
):
    """
    Measure inference latency for different model types (parametric + blackbox).
    """
    batch = gen_scene_batch_revision(cfg, batch_size, L, 10.0, device, array_type="ula", error_type="combined")
    rows = []

    for name, mdl in models.items():
        mdl.eval()

        # Warm-up
        for _ in range(5):
            if isinstance(mdl, (BlackBoxEigenMLP, CVCNNBeamformer, GRURNNBeamformer)):
                w = mdl(batch["Rhat"], batch["a_nom"])
            else:
                out = mdl(batch["Rhat"])
                w = robust_beamformer_from_params(
                    batch["Rhat"], batch["bar_a"],
                    out["tau"], out["rho"], out["lam_diag"]
                )

        if device.type == "cuda":
            torch.cuda.synchronize()

        t0 = time.perf_counter()
        for _ in range(repeat):
            if isinstance(mdl, (BlackBoxEigenMLP, CVCNNBeamformer, GRURNNBeamformer)):
                w = mdl(batch["Rhat"], batch["a_nom"])
            else:
                out = mdl(batch["Rhat"])
                w = robust_beamformer_from_params(
                    batch["Rhat"], batch["bar_a"],
                    out["tau"], out["rho"], out["lam_diag"]
                )
        if device.type == "cuda":
            torch.cuda.synchronize()

        batch_ms = 1000.0 * (time.perf_counter() - t0) / float(repeat)
        per_sample_ms = batch_ms / float(batch_size)

        rows.append([
            name,
            count_trainable_params(mdl),
            f"{batch_ms:.4f}",
            f"{per_sample_ms:.6f}",
        ])

    write_csv(
        os.path.join(out_dir, "table_complexity_latency.csv"),
        ["method", "trainable_params", "batch_ms", "per_sample_ms"],
        rows,
    )

    write_tex_table(
        os.path.join(out_dir, "table_complexity_latency.tex"),
        caption="Model size and inference latency.",
        label="tab:complexity_latency",
        colspec="lccc",
        header_lines=["Method & Params & Batch latency (ms) & Per-sample latency (ms) \\\\"],
        body_lines=[f"{r[0]} & {r[1]} & {r[2]} & {r[3]} \\\\" for r in rows],
        notes="Latency is measured for a batch of covariance matrices including neural inference and differentiable beamforming mapping.",
    )

