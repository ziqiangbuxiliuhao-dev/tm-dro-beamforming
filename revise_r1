def plot_revision_grouped_bars(table: Dict[str, Dict[str, float]], ylabel: str, out_base: str):
    set_pub_style()

    groups = list(table.keys())
    methods = list(next(iter(table.values())).keys())
    x = np.arange(len(groups), dtype=np.float64)
    width = 0.82 / max(1, len(methods))

    plt.figure(figsize=(7.2, 4.6))
    ax = plt.gca()

    # Use global METHOD_STYLE to keep bar colors consistent with line plots
    methods = sorted(
        methods,
        key=lambda m: METHOD_RANK.get(canonical_method_name(m), 999)
    )

    for j, m in enumerate(methods):
        y = [table[g][m] for g in groups]
        st = get_method_style(m)
        color = st["color"]

        ax.bar(
            x - 0.41 + width / 2.0 + j * width,
            y,
            width,
            label=m,
            color=color,
            edgecolor="black",
            linewidth=0.8,
        )
    plt.xticks(x, groups, rotation=0, ha="center")
    plt.ylabel(ylabel)
    apply_axis_style(ax)
    legend_outside_bottom(ax, max_cols=4, y_offset=-0.38)

    savefig_dual(out_base)
    plt.close()

