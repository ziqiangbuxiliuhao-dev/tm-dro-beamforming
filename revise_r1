# New SOTA baselines:
#   1) IPN-UDL (TSP2025)
#   2) IRDRCB-Krylov (Sensors2024)
#   3) WC-QMI-A1-LMI (TSP2023)
# =========================================================

def default_ula_positions_2d(N: int, d_over_lambda: float, device):
    """Return [N,2] ULA positions in wavelength units."""
    x = torch.arange(N, device=device, dtype=torch.float32) * float(d_over_lambda)
    y = torch.zeros_like(x)
    return torch.stack([x, y], dim=-1)


def steering_from_positions_safe(pos_nom: torch.Tensor,
                                 theta_deg: torch.Tensor,
                                 device,
                                 dtype=torch.complex64) -> torch.Tensor:
    """
    pos_nom: [N,2] in wavelength units.
    theta_deg: [G] or [B].
    return: [G,N] or [B,N], normalized to ||a||=1.
    """
    theta = theta_deg.to(device=device, dtype=torch.float32) * math.pi / 180.0
    ux = torch.sin(theta)[:, None]
    uy = torch.cos(theta)[:, None]

    phase = 2.0 * math.pi * (
        ux * pos_nom[None, :, 0] + uy * pos_nom[None, :, 1]
    )
    a = torch.exp(1j * phase.to(torch.complex64))
    a = a / torch.linalg.norm(a, dim=-1, keepdim=True).clamp_min(1e-12)
    return a.to(dtype)


@torch.no_grad()
def ipn_udl_weight(
    Rhat: torch.Tensor,
    a_nom: torch.Tensor,
    pos_nom: Optional[torch.Tensor] = None,
    theta_s_nom_deg: float = -5.0,
    d_over_lambda: float = 0.5,
    soi_exclude_deg: float = 10.0,
    grid_step_deg: float = 2.0,
    K_udl: int = 3,
    delta1_rel: float = 10.0,
    delta2_rel: float = 1e-2,
    final_dl_rel: float = 1e-3,
) -> torch.Tensor:
    """
    IPN-UDL baseline inspired by Wang-Dai-Li TSP 2025.

    Steps:
      1) UDL high-resolution Capon spectrum:
             Gamma = U_s delta1 U_s^H + U_n delta2 U_n^H
             P(theta) = 1 / a^H (Rhat + Gamma)^(-1) a
      2) Reconstruct IPN covariance outside SOI sector.
      3) Final diagonally-loaded MVDR using reconstructed IPN.

    Note:
      - This matches existing CMR-Capon style, but replaces the Capon
        spectrum matrix Rhat with Rhat + Gamma and adds final DL.
      - pos_nom is optional. If not provided, a ULA is assumed.
    """
    B, N, _ = Rhat.shape
    device = Rhat.device
    dtype = Rhat.dtype

    if pos_nom is None:
        pos_nom = default_ula_positions_2d(N, d_over_lambda, device)

    I = cplx_eye(N, device, dtype=dtype)[None].expand(B, -1, -1)

    # ---------- UDL matrix Gamma ----------
    evals, evecs = torch.linalg.eigh(hermitize(Rhat))  # ascending
    idx = torch.argsort(evals, dim=-1, descending=True)
    evecs_desc = torch.gather(
        evecs, 2, idx[:, None, :].expand(B, N, N)
    )
    K = min(max(1, K_udl), N - 1)
    Us = evecs_desc[:, :, :K]
    Un = evecs_desc[:, :, K:]

    scale = (trace_batch(Rhat).real / float(N)).clamp_min(1e-8)
    delta1 = delta1_rel * scale
    delta2 = delta2_rel * scale

    Gamma = (
        delta1[:, None, None].to(dtype) * (Us @ Us.conj().transpose(-1, -2))
        + delta2[:, None, None].to(dtype) * (Un @ Un.conj().transpose(-1, -2))
    )
    Rudl = hermitize(Rhat + Gamma + 1e-6 * scale[:, None, None].to(dtype) * I)

    # ---------- angular grid outside SOI sector ----------
    grid = torch.arange(-90.0, 90.0 + 1e-6, grid_step_deg, device=device)
    mask = torch.abs(grid - float(theta_s_nom_deg)) > float(soi_exclude_deg)
    grid_i = grid[mask]
    A = steering_from_positions_safe(pos_nom, grid_i, device, dtype=dtype)  # [G,N]
    G = A.shape[0]

    # ---------- UDL-Capon spectrum ----------
    rhs = A.t().unsqueeze(0).expand(B, -1, -1)  # [B,N,G]
    RinvA = torch.linalg.solve(Rudl, rhs)
    denom = (A.conj().t().unsqueeze(0) * RinvA).sum(dim=1).real.clamp_min(1e-8)
    P = 1.0 / denom
    P = P / P.mean(dim=-1, keepdim=True).clamp_min(1e-12)

    # ---------- IPN covariance reconstruction ----------
    Rrec = torch.zeros_like(Rhat)
    for g in range(G):
        ag = A[g][None, :].expand(B, -1)
        Rrec = Rrec + P[:, g][:, None, None].to(dtype) * (
            ag[:, :, None] * ag.conj()[:, None, :]
        )
    Rrec = Rrec / float(G)

    noise_floor = evals[:, :max(1, N // 3)].mean(dim=-1).clamp_min(1e-8)
    final_dl = final_dl_rel * scale
    Rrec = hermitize(
        Rrec
        + noise_floor[:, None, None].to(dtype) * I
        + final_dl[:, None, None].to(dtype) * I
    )

    return mvdr_weight(Rrec, a_nom)


def _krylov_basis_single(R: torch.Tensor, a: torch.Tensor, rank: int) -> torch.Tensor:
    """
    Build an orthonormal Krylov basis span{a, R a, R^2 a, ...}.
    R: [N,N], a: [N]
    return D: [N,K]
    """
    N = a.numel()
    K = min(rank, N)
    vecs = []

    v = a / torch.linalg.norm(a).clamp_min(1e-12)
    for _ in range(K):
        # Modified Gram-Schmidt
        q = v.clone()
        for u in vecs:
            q = q - u * (torch.conj(u) @ q)
        nq = torch.linalg.norm(q)
        if nq < 1e-8:
            break
        q = q / nq
        vecs.append(q)
        v = R @ q

    if len(vecs) == 0:
        vecs = [a / torch.linalg.norm(a).clamp_min(1e-12)]

    return torch.stack(vecs, dim=-1)


@torch.no_grad()
def irdrcb_krylov_weight(
    Rhat: torch.Tensor,
    a_nom: torch.Tensor,
    rank: int = 6,
    loading_rel_low: float = 1e-6,
    loading_rel_high: float = 1e2,
    norm_bound: float = 10.0,
    bisect_iters: int = 35,
) -> torch.Tensor:
    """
    Practical IRDRCB-Krylov baseline.

    This is a reduced-dimension robust Capon implementation:
      1) Build Krylov subspace D.
      2) Solve reduced-rank diagonally loaded MVDR.
      3) Use bisection to keep the loading level valid and control ||w||^2.

    It is intentionally stable for Monte-Carlo simulations.
    Name in paper/table: IRDRCB-Krylov.
    """
    B, N, _ = Rhat.shape
    device = Rhat.device
    dtype = Rhat.dtype

    w_list = []
    for b in range(B):
        Rb = hermitize(Rhat[b])
        ab = a_nom[b]

        scale = (torch.trace(Rb).real / float(N)).clamp_min(1e-8)
        D = _krylov_basis_single(Rb, ab, rank=rank)  # [N,K]
        K = D.shape[-1]

        Rr = hermitize(D.conj().transpose(-1, -2) @ Rb @ D)
        ar = D.conj().transpose(-1, -2) @ ab
        Ir = torch.eye(K, device=device, dtype=dtype)

        lo = loading_rel_low * scale
        hi = loading_rel_high * scale

        def reduced_weight(mu):
            xr = torch.linalg.solve(Rr + mu.to(dtype) * Ir, ar)
            den = (torch.conj(ar) * xr).sum().real.clamp_min(1e-12)
            wr = xr / den.to(dtype)
            wf = D @ wr
            den2 = (torch.conj(wf) * ab).sum()
            wf = wf / (torch.conj(den2) + 1e-8)
            return wf

        # If low loading already satisfies norm bound, use it.
        w_lo = reduced_weight(lo)
        if (torch.linalg.norm(w_lo).real ** 2) <= norm_bound:
            w_list.append(w_lo)
            continue

        # Bisection on loading. Larger loading usually lowers white-noise sensitivity.
        for _ in range(bisect_iters):
            mid = 0.5 * (lo + hi)
            wm = reduced_weight(mid)
            if (torch.linalg.norm(wm).real ** 2) > norm_bound:
                lo = mid
            else:
                hi = mid

        w_list.append(reduced_weight(hi))

    return torch.stack(w_list, dim=0).to(dtype)


@torch.no_grad()
def wc_qmi_a1_lmi_weight(
    Rhat: torch.Tensor,
    a_nom: torch.Tensor,
    delta_frac: float = 0.30,
    eta1_frac: float = 0.20,
    eta2_frac: float = 0.20,
    cov_dl_rel: float = 0.10,
    solver: str = "SCS",
    verbose: bool = False,
    max_iters: int = 500,
    eps: float = 1e-3,
) -> torch.Tensor:
    """
    Worst-case SINR with nonconvex steering uncertainty set A1:
        ||a-a_hat||^2 <= Delta,
        norm2-eta1 <= ||a||^2 <= norm2+eta2.

    This implements the tightened LMI relaxation of the QMI-A1 formulation.
    It extracts the principal rank-one approximation if W is not numerically rank-one.

    Important:
       steering vectors are normalized to ||a||=1, while the paper often uses
      ||a||^2=N. Therefore Delta/eta are scaled by norm2 = ||a_nom||^2.
    """
    B, N, _ = Rhat.shape
    device = Rhat.device
    dtype = torch.complex64

    w_list = []

    for b in range(B):
        R_np = hermitize(Rhat[b]).detach().cpu().numpy().astype(np.complex128)
        a_np = a_nom[b].detach().cpu().numpy().astype(np.complex128)

        norm2 = float(np.vdot(a_np, a_np).real)
        Delta = float(delta_frac * norm2)
        eta1 = float(eta1_frac * norm2)
        eta2 = float(eta2_frac * norm2)

        # covariance uncertainty loading: R_hat in the paper can include sqrt(gamma) I
        lam_min = max(float(np.linalg.eigvalsh(R_np).min().real), 1e-8)
        R_np = R_np + (cov_dl_rel * lam_min) * np.eye(N, dtype=np.complex128)
        R_np = 0.5 * (R_np + R_np.conj().T)

        W = cp.Variable((N, N), hermitian=True)
        y1 = cp.Variable()
        y2 = cp.Variable()
        y3 = cp.Variable()
        y4 = cp.Variable()

        top_left = W - (y1 + y2 + y3) * np.eye(N)
        top_right = cp.reshape(y1 * a_np, (N, 1), order="F")
        bottom_left = cp.reshape(y1 * a_np.conj(), (1, N), order="F")
        bottom_right = cp.reshape(
            -y4 - y1 * (norm2 - Delta), (1, 1), order="F"
        )

        Q = cp.bmat([
            [top_left, top_right],
            [bottom_left, bottom_right],
        ])

        constraints = [
            (norm2 - eta1) * y2 + (norm2 + eta2) * y3 + y4 == 1,
            Q >> 0,
            W >> 0,
            y1 <= 0,
            y2 >= 0,
            y3 <= 0,
            y1 + y2 + y3 <= 0,   # tightened valid linear constraint
        ]

        obj = cp.Minimize(cp.real(cp.trace(R_np @ W)))
        prob = cp.Problem(obj, constraints)

        try:
            prob.solve(
                solver=solver,
                verbose=verbose,
                max_iters=max_iters,
                eps=eps,
                warm_start=True,
            )
            Wv = W.value
            if Wv is None or not np.all(np.isfinite(Wv)):
                raise RuntimeError("WC-QMI solver returned invalid W")

            Wv = 0.5 * (Wv + Wv.conj().T)
            vals, vecs = np.linalg.eigh(Wv)
            idx = int(np.argmax(vals.real))
            val = max(float(vals[idx].real), 1e-12)
            w = np.sqrt(val) * vecs[:, idx]

            # distortionless normalization
            den = np.vdot(w, a_np)
            if abs(den) < 1e-10:
                raise RuntimeError("WC-QMI normalization failed")
            w = w / den.conj()

        except Exception:
            # stable fallback: do not crash Monte Carlo
            R_t = torch.tensor(R_np[None], device=device, dtype=dtype)
            a_t = torch.tensor(a_np[None], device=device, dtype=dtype)
            w = mvdr_weight(R_t, a_t)[0].detach().cpu().numpy()

        w_list.append(w.astype(np.complex64))

    return torch.tensor(np.stack(w_list), device=device, dtype=dtype)

# =========================================================
# Metrics
# =========================================================
def sinr_out_db(w, a_true, Rin_true, sigma_s2) -> torch.Tensor:
    num = sigma_s2 * abs2((torch.conj(w) * a_true).sum(dim=-1))
    den = quad_form(w, Rin_true).clamp_min(1e-12)
    sinr = (num / den).clamp_min(1e-12)
    return 10.0 * torch.log10(sinr)


def catastrophic_rate(sinr_db: np.ndarray, thr_db: float = -5.0) -> float:
    s = np.asarray(sinr_db).reshape(-1)
    return float(100.0 * np.mean(s < thr_db))


# =========================================================
# Training (maximize mean SINR)
# =========================================================
def train_model(model: nn.Module, cfg: SimCfg, device,
                epochs: int, steps_per_epoch: int, batch_size: int,
                L_choices: Tuple[int, ...], snr_range: Tuple[float, float],
                lr: float = 3e-4) -> Dict[str, List[float]]:
    model.train()
    opt = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)
    hist = {"train": [], "val": []}

    def val_step(num_batches: int = 20) -> float:
        model.eval()
        vals = []
        with torch.no_grad():
            for _ in range(num_batches):
                L = random.choice(L_choices)
                snr = snr_range[0] + (snr_range[1] - snr_range[0]) * torch.rand(batch_size, device=device)
                batch = gen_scene_batch(cfg, batch_size, L, snr, device)
                out = model(batch["Rhat"])
                w = robust_beamformer_from_params(batch["Rhat"], batch["bar_a"], out["tau"], out["rho"], out["lam_diag"])
                sinr = sinr_out_db(w, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])
                vals.append((-sinr.mean()).item())
        model.train()
        return float(np.mean(vals))

    for ep in range(1, epochs + 1):
        losses = []
        for _ in range(steps_per_epoch):
            L = random.choice(L_choices)
            snr = snr_range[0] + (snr_range[1] - snr_range[0]) * torch.rand(batch_size, device=device)
            batch = gen_scene_batch(cfg, batch_size, L, snr, device)

            out = model(batch["Rhat"])
            w = robust_beamformer_from_params(batch["Rhat"], batch["bar_a"], out["tau"], out["rho"], out["lam_diag"])
            sinr = sinr_out_db(w, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])
            loss_main = -sinr.mean()

            reg = 1e-4 * (out["rho"] ** 2).mean() + 1e-4 * (out["tau"] ** 2).mean()
            reg = reg + 1e-5 * (safe_log(out["lam_diag"]) ** 2).mean()
            loss = loss_main + reg

            opt.zero_grad(set_to_none=True)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            opt.step()
            losses.append(loss_main.item())

        v = val_step()
        hist["train"].append(float(np.mean(losses)))
        hist["val"].append(v)
        print(f"Epoch {ep:03d}/{epochs} | train(-mean SINR dB)={hist['train'][-1]:.3f} | val={v:.3f}")

    return hist


