def plot_eigenspectra(R_list: List[torch.Tensor], labels: List[str], out_base: str,
                      use_log=True, normalize_trace=True):
    """
    Plot trace-normalized eigenspectra with publication-style line/marker design.
    Drop-in replacement for the original plot_eigenspectra().
    """
    set_pub_style()
    plt.figure(figsize=(6.2, 4.1))

    # Shorter legend labels
    label_map = {
        "Case A: noise-dom": "Noise-dominated",
        "Case B: target+noise": "Target + noise",
        "Case C: +interf+mismatch": "Interference + mismatch",
    }

    # Distinct color + marker + line style
    style_map = {
        "Noise-dominated": {
            "color": "#1f77b4",
            "marker": "o",
            "linestyle": "-",
        },
        "Target + noise": {
            "color": "#ff7f0e",
            "marker": "s",
            "linestyle": "--",
        },
        "Interference + mismatch": {
            "color": "#2ca02c",
            "marker": "^",
            "linestyle": "-.",
        },
    }

    for R, lb in zip(R_list, labels):
        Rb = hermitize(R)
        evals = torch.linalg.eigvalsh(Rb).real
        evals = torch.flip(evals, dims=[-1])

        if normalize_trace:
            evals = evals / evals.sum().clamp_min(1e-12)

        y = evals.clamp_min(1e-12)
        if use_log:
            y = torch.log(y)

        y = y.detach().cpu().numpy()
        x = np.arange(1, len(y) + 1)

        plot_label = label_map.get(lb, lb)
        st = style_map.get(plot_label, {})

        plt.plot(
            x,
            y,
            label=plot_label,
            color=st.get("color", None),
            marker=st.get("marker", "o"),
            linestyle=st.get("linestyle", "-"),
            linewidth=2.2,
            markersize=5.8,
            markerfacecolor=st.get("color", None),
            markeredgecolor="white",
            markeredgewidth=0.8,
        )

    ax = plt.gca()

    plt.xlabel("Eigenvalue index (descending)")
    if use_log and normalize_trace:
        plt.ylabel(r"$\log(\lambda_i)$, trace-normalized")
    elif use_log:
        plt.ylabel(r"$\log(\lambda_i)$")
    else:
        plt.ylabel(r"$\lambda_i$")

    ax.set_xlim(0.8, len(R_list[0]) + 0.2 if hasattr(R_list[0], "__len__") else 10.2)
    ax.set_ylim(-6.2, -0.3)

    apply_axis_style(ax)

    leg = ax.legend(
        loc="lower center",
        bbox_to_anchor=(0.5, -0.35),
        ncol=3,
        frameon=True,
        fancybox=False,
        fontsize=9,
        columnspacing=1.0,
        handlelength=2.2,
        handletextpad=0.5,
        borderpad=0.45,
    )
    leg.get_frame().set_linewidth(0.8)
    leg.get_frame().set_alpha(0.95)

    plt.subplots_adjust(bottom=0.30)
    savefig_dual(out_base)
    plt.close()

