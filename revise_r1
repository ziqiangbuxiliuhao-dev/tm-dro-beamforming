@torch.no_grad()
def eval_methods_revision(
    cfg: SimCfg,
    device,
    snr_db: float,
    L: int,
    mc: int,
    model_dict: Dict[str, nn.Module],
    array_type: str = "ula",
    error_type: str = "angle",
    outage_thr_db: float = -5.0,
) -> Dict[str, np.ndarray]:
    batch = gen_scene_batch_revision(cfg, mc, L, snr_db, device, array_type=array_type, error_type=error_type)
    # ==================== Fast settings for slow CVXPY baselines ====================
    CVXPY_MC = 10  # 两个慢方法只用 10 个样本；想稳一点可改成 20
    IRANI_MAX_ITER = 0  # 0 = 不跑 penalty refinement，最快；想稳一点可改成 3
    WC_MAX_ITERS = 500  # WC-QMI 的 SCS 迭代数；想稳一点可改成 800
    WC_EPS = 1e-3  # SCS 精度；越大越快

    slow_mc = min(CVXPY_MC, mc)

    batch_slow = {}
    for k, v in batch.items():
        if torch.is_tensor(v) and v.ndim > 0 and v.shape[0] == mc:
            batch_slow[k] = v[:slow_mc]
        else:
            batch_slow[k] = v
    res = {}

    # Oracle (perfect knowledge)
    w_oracle = mvdr_weight(batch["Rin_true"], batch["a_true"])
    res["Oracle"] = sinr_out_db(w_oracle, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    # Baselines (fast)
    w_smi = mvdr_weight(batch["Rhat"], batch["a_nom"])
    res["SMI MVDR"] = sinr_out_db(w_smi, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    w_lsmi = lsmi_weight(batch["Rhat"], batch["a_nom"], beta=0.1)
    res["LSMI"] = sinr_out_db(w_lsmi, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    w_oas = oas_shrinkage_mvdr_weight(batch["Rhat"], batch["a_nom"], L=L)
    res["OAS-Shrinkage"] = sinr_out_db(w_oas, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    w_rcb = rcb_weight(batch["Rhat"], batch["a_nom"], eps=0.15)
    res["RCB"] = sinr_out_db(w_rcb, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    w_cmr = cmr_capon_weight(
        batch["Rhat"], batch["a_nom"], batch["pos_nom"],
        theta_s_nom_deg=cfg.theta_s_nom_deg,
        exclude_deg=10.0, grid_step_deg=2.0, rho=1e-3
    )
    res["CMR-Capon"] = sinr_out_db(w_cmr, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    w_meps = meps_ipnc_weight(
        batch["Rhat"], batch["a_nom"], batch["pos_nom"],
        theta_s_nom_deg=cfg.theta_s_nom_deg,
        soi_sector_deg=6.0,
        grid_i_step_deg=2.0,
        grid_s_step_deg=1.0,
        rho=1e-3,
        estimate_sv=True,
    )
    res["MEPS-IPNC (SPL2020)"] = sinr_out_db(
        w_meps, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]
    ).cpu().numpy()

    w_pglq = pglq_incm_weight(
        batch["Rhat"], batch["a_nom"], batch["pos_nom"],
        theta_s_nom_deg=cfg.theta_s_nom_deg,
        exclude_deg=6.0,
        Q=3,
        null_width_u=None,
        signal_subspace_dim=4,
        peak_gain=3.0,
        rho=1e-3,
    )
    res["PGLQ-INCM (SP2026)"] = sinr_out_db(
        w_pglq, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]
    ).cpu().numpy()

    # ==================== 临时禁用最慢的两个 CVXPY 方法 ====================
    # ==================== Slow CVXPY optimization baselines ====================

    # Irani DRO (TSP2025)
    try:
        w_irani = irani_dro_weight(
            batch_slow["Rhat"],
            batch_slow["a_nom"],
            max_iter=IRANI_MAX_ITER,
        )
        res["Irani DRO (TSP2025)"] = sinr_out_db(
            w_irani,
            batch_slow["a_true"],
            batch_slow["Rin_true"],
            batch_slow["sigma_s2"],
        ).cpu().numpy()
    except Exception as e:
        print(f"[Warning] Irani DRO failed, fallback to SMI MVDR. Error: {e}")
        res["Irani DRO (TSP2025)"] = sinr_out_db(
            w_irani,
            batch_slow["a_true"],
            batch_slow["Rin_true"],
            batch_slow["sigma_s2"],
        ).cpu().numpy()

    # WC-QMI-A1-LMI (TSP2023)
    try:
        w_wc = wc_qmi_a1_lmi_weight(
            batch_slow["Rhat"],
            batch_slow["a_nom"],
            solver="SCS",
            verbose=False,
            max_iters=WC_MAX_ITERS,
            eps=WC_EPS,
        )
        res["WC-QMI-A1-LMI (TSP2023)"] = sinr_out_db(
            w_wc,
            batch_slow["a_true"],
            batch_slow["Rin_true"],
            batch_slow["sigma_s2"],
        ).cpu().numpy()
    except Exception as e:
        print(f"[Warning] WC-QMI-A1-LMI failed, fallback to SMI MVDR. Error: {e}")
        res["WC-QMI-A1-LMI (TSP2023)"] = sinr_out_db(
            w_wc,
            batch_slow["a_true"],
            batch_slow["Rin_true"],
            batch_slow["sigma_s2"],
        ).cpu().numpy()

    # 其他快速方法
    w_udl = ipn_udl_weight(
        batch["Rhat"], batch["a_nom"],
        pos_nom=batch["pos_nom"],
        theta_s_nom_deg=cfg.theta_s_nom_deg,
        d_over_lambda=cfg.d_over_lambda,
        soi_exclude_deg=10.0,
        grid_step_deg=2.0,
        K_udl=3,
    )
    res["IPN-UDL (TSP2025)"] = sinr_out_db(
        w_udl, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]
    ).cpu().numpy()

    pos_nom0 = batch["pos_nom"]
    w_meps = meps_ipnc_weight(
        batch["Rhat"], batch["a_nom"], pos_nom0,
        theta_s_nom_deg=cfg.theta_s_nom_deg,
        soi_sector_deg=6.0,
        grid_i_step_deg=2.0,
        grid_s_step_deg=1.0,
        rho=1e-3,
        estimate_sv=True,
    )
    res["MEPS-IPNC (SPL2020)"] = sinr_out_db(
        w_meps, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]
    ).cpu().numpy()

    w_pglq = pglq_incm_weight(
        batch["Rhat"], batch["a_nom"], pos_nom0,
        theta_s_nom_deg=cfg.theta_s_nom_deg,
        exclude_deg=6.0,
        Q=3,
        null_width_u=None,
        signal_subspace_dim=4,
        peak_gain=3.0,
        rho=1e-3,
    )
    res["PGLQ-INCM (SP2026)"] = sinr_out_db(
        w_pglq, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]
    ).cpu().numpy()

    w_irdrcb = irdrcb_krylov_weight(
        batch["Rhat"], batch["a_nom"],
        rank=min(6, cfg.N),
        norm_bound=10.0,
    )
    res["IRDRCB-Krylov (Sensors2024)"] = sinr_out_db(
        w_irdrcb, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]
    ).cpu().numpy()

    # Proposed models + blackbox baselines
    for name, mdl in model_dict.items():
        mdl.eval()
        if isinstance(mdl, (BlackBoxEigenMLP, CVCNNBeamformer, GRURNNBeamformer)):
            w = mdl(batch["Rhat"], batch["a_nom"])
        else:
            out = mdl(batch["Rhat"])
            w = robust_beamformer_from_params(
                batch["Rhat"], batch["bar_a"],
                out["tau"], out["rho"], out["lam_diag"]
            )
        res[name] = sinr_out_db(w, batch["a_true"], batch["Rin_true"], batch["sigma_s2"]).cpu().numpy()

    return res
def summarize_revision_result(res: Dict[str, np.ndarray], outage_thr_db: float = -5.0) -> List[List]:
    rows = []
    for name, v in res.items():
        rows.append([
            name,
            float(np.mean(v)),
            float(np.median(v)),
            float(np.std(v)),
            catastrophic_rate(v, thr_db=outage_thr_db),
        ])
    return rows


