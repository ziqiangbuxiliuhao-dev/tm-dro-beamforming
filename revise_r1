    array_choices: Tuple[str, ...] = ("ula", "uca", "ccaa"),   # ← 新增这一行
    lr: float = 3e-4,
):
    model.train()
    opt = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)

    for ep in range(1, epochs + 1):
        losses = []
        for _ in range(steps_per_epoch):
            L = random.choice(L_choices)
            snr = snr_range[0] + (snr_range[1] - snr_range[0]) * random.random()
            err = random.choice(error_choices)
            array_type = random.choice(array_choices)          # ← 新增这一行

            batch = gen_scene_batch_revision(
                cfg, batch_size, L, snr, device,
                array_type=array_type,          # ← 修改这里（原来写死 "ula"）
                error_type=err
            )

            # ... 后面的代码保持不变
            out = model(batch["Rhat"])
            w = robust_beamformer_from_params(batch["Rhat"], batch["bar_a"], out["tau"], out["rho"], out["lam_diag"])
            sinr = sinr_out_db(w, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])

            reg = 1e-4 * (out["rho"] ** 2).mean() + 1e-4 * (out["tau"] ** 2).mean()
            reg = reg + 1e-5 * (safe_log(out["lam_diag"]) ** 2).mean()
            loss = -sinr.mean() + reg

            opt.zero_grad(set_to_none=True)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            opt.step()
            losses.append(loss.item())

        print(f"Revision train epoch {ep:03d}/{epochs} | train(-mean SINR dB)={np.mean(losses):.3f}")


