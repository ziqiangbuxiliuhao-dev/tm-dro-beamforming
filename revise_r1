# 3) Additional baselines requested by reviewers
# ---------------------------------------------------------
def oas_shrinkage_mvdr_weight(Rhat: torch.Tensor, a: torch.Tensor, L: int = 100) -> torch.Tensor:
    """
    Oracle-free OAS-like shrinkage MVDR.
    This is a stronger shrinkage baseline than a fixed-alpha shrinkage.
    """
    B, N, _ = Rhat.shape
    dtype = Rhat.dtype
    I = cplx_eye(N, Rhat.device, dtype=dtype)[None].expand(B, -1, -1)

    trR = trace_batch(Rhat).real.clamp_min(1e-12)
    mu = trR / float(N)
    fro2 = abs2(Rhat).sum(dim=(-1, -2)).real.clamp_min(1e-12)

    denom = ((L + 1.0 - 2.0 / N) * (fro2 - trR * trR / N)).clamp_min(1e-12)
    numer = ((1.0 - 2.0 / N) * fro2 + trR * trR).clamp_min(0.0)
    alpha = (numer / denom).clamp(0.02, 0.95)

    Rsh = (1.0 - alpha[:, None, None]) * Rhat + alpha[:, None, None].to(dtype) * mu[:, None, None].to(dtype) * I
    Rsh = hermitize(Rsh)
    return mvdr_weight(Rsh, a)


def cmr_capon_weight(
    Rhat: torch.Tensor,
    a_nom: torch.Tensor,
    pos_nom: torch.Tensor,
    theta_s_nom_deg: float,
    exclude_deg: float = 10.0,
    grid_step_deg: float = 2.0,
    rho: float = 1e-3,
) -> torch.Tensor:
    """
    Covariance Matrix Reconstruction baseline.
    Reconstruct interference-plus-noise covariance by integrating Capon spectrum outside SOI sector.
    """
    B, N, _ = Rhat.shape
    device = Rhat.device
    dtype = Rhat.dtype
    I = cplx_eye(N, device, dtype=dtype)[None].expand(B, -1, -1)
    Rl = Rhat + rho * I

    grid = torch.arange(-90.0, 90.0 + 1e-6, grid_step_deg, device=device)
    mask = torch.abs(grid - float(theta_s_nom_deg)) > exclude_deg
    grid_i = grid[mask]

    A = steering_from_positions(pos_nom, grid_i, device, dtype=dtype)  # [G,N]
    G = A.shape[0]

    rhs = A.t().unsqueeze(0).expand(B, -1, -1)  # [B,N,G]
    RinvA = torch.linalg.solve(Rl, rhs)
    denom = (A.conj().t().unsqueeze(0) * RinvA).sum(dim=1).real.clamp_min(1e-8)  # [B,G]
    P = 1.0 / denom
    P = P / P.mean(dim=-1, keepdim=True).clamp_min(1e-12)

    Rrec = torch.zeros_like(Rhat)
    for g in range(G):
        ag = A[g][None, :].expand(B, -1)
        Rrec = Rrec + P[:, g][:, None, None].to(dtype) * ag[:, :, None] * ag.conj()[:, None, :]

    Rrec = Rrec / float(G)

    evals = torch.linalg.eigvalsh(Rhat).real
    noise_floor = evals[:, :max(1, N // 3)].mean(dim=-1).clamp_min(1e-6)
    Rrec = hermitize(Rrec + noise_floor[:, None, None].to(dtype) * I)

    return mvdr_weight(Rrec, a_nom)


# ---------------------------------------------------------
# 3b) Added reconstruction baselines: MEPS-IPNC and PGLQ-INCM
# ---------------------------------------------------------
def _sidelobe_uniform_grid(theta_s_nom_deg: float,
                           exclude_deg: float,
                           step_deg: float,
                           device) -> torch.Tensor:
    """Uniform theta grid outside the SOI sector."""
    left = torch.arange(-90.0, float(theta_s_nom_deg) - exclude_deg + 1e-6, step_deg, device=device)
    right = torch.arange(float(theta_s_nom_deg) + exclude_deg, 90.0 + 1e-6, step_deg, device=device)
    if left.numel() == 0:
        return right
    if right.numel() == 0:
        return left
    return torch.cat([left, right], dim=0)


def _add_noise_floor(Rrec: torch.Tensor, Rref: torch.Tensor, rel_floor: float = 1e-3) -> torch.Tensor:
    """Small diagonal floor to keep reconstructed covariance positive definite."""
    B, N, _ = Rref.shape
    dtype = Rref.dtype
    I = cplx_eye(N, Rref.device, dtype=dtype)[None].expand(B, -1, -1)
    evals = torch.linalg.eigvalsh(hermitize(Rref)).real
    nf = evals[:, :max(1, N // 3)].mean(dim=-1).clamp_min(1e-6)
    return hermitize(Rrec + rel_floor * nf[:, None, None].to(dtype) * I)


@torch.no_grad()
def meps_ipnc_weight(
    Rhat: torch.Tensor,
    a_nom: torch.Tensor,
    pos_nom: torch.Tensor,
    theta_s_nom_deg: float,
    soi_sector_deg: float = 6.0,
    grid_i_step_deg: float = 1.0,
    grid_s_step_deg: float = 1.0,
    rho: float = 1e-3,
    estimate_sv: bool = True,
) -> torch.Tensor:
    """
    MEPS-IPNC baseline.

    1) Use MEPS spectrum P_meps(theta)=1/(epsilon_p * |a(theta)^H R^-1 u1|^2).
    2) Reconstruct IPNC outside the SOI sector.
    3) Optionally reconstruct desired covariance inside the SOI sector and set a_hat = R_s a_nom.
    4) MVDR with reconstructed IPNC and a_hat.
    """
    B, N, _ = Rhat.shape
    device = Rhat.device
    dtype = Rhat.dtype
    I = cplx_eye(N, device, dtype=dtype)[None].expand(B, -1, -1)
    Rl = hermitize(Rhat + rho * I)

    u1 = torch.zeros(N, device=device, dtype=dtype)
    u1[0] = 1.0 + 0.0j
    Rinv_u1 = torch.linalg.solve(Rl, u1[None, :, None].expand(B, -1, -1)).squeeze(-1)  # [B,N]
    eps_p = 1.0 / ((torch.conj(u1)[None, :] * Rinv_u1).sum(dim=-1).real.clamp_min(1e-10))  # [B]

    def meps_power(A: torch.Tensor) -> torch.Tensor:
        # A: [G,N]; return [B,G]
        z = (torch.conj(A)[None, :, :] * Rinv_u1[:, None, :]).sum(dim=-1)  # a^H R^-1 u1
        P = 1.0 / (eps_p[:, None] * abs2(z).clamp_min(1e-12))
        return P / P.mean(dim=-1, keepdim=True).clamp_min(1e-12)

    def reconstruct(A: torch.Tensor, P: torch.Tensor) -> torch.Tensor:
        G = A.shape[0]
        Rrec = torch.zeros_like(Rhat)
        for g in range(G):
            ag = A[g][None, :].expand(B, -1)
            Rrec = Rrec + P[:, g][:, None, None].to(dtype) * ag[:, :, None] * ag.conj()[:, None, :]
        return Rrec / max(1, G)

    # Interference-plus-noise sector: outside SOI sector.
    theta_i = _sidelobe_uniform_grid(theta_s_nom_deg, soi_sector_deg, grid_i_step_deg, device)
    A_i = steering_from_positions(pos_nom, theta_i, device, dtype=dtype)
    R_ipn = reconstruct(A_i, meps_power(A_i))
    R_ipn = _add_noise_floor(R_ipn, Rhat, rel_floor=1e-2)

    if estimate_sv:
        theta_s = torch.arange(
            float(theta_s_nom_deg) - soi_sector_deg,
            float(theta_s_nom_deg) + soi_sector_deg + 1e-6,
            grid_s_step_deg,
            device=device,
        )
        A_s = steering_from_positions(pos_nom, theta_s, device, dtype=dtype)
        R_s = reconstruct(A_s, meps_power(A_s))
        a_hat = (R_s @ a_nom.unsqueeze(-1)).squeeze(-1)
        a_hat = normalize_complex_vec(a_hat)
        # Fallback: avoid rare numerical zero vector.
        bad = torch.linalg.norm(a_hat, dim=-1) < 1e-8
        if bad.any():
            a_hat[bad] = a_nom[bad]
    else:
        a_hat = a_nom

    return mvdr_weight(R_ipn, a_hat)


def _pglq_theta_nodes_weights(
    theta_s_nom_deg: float,
    exclude_deg: float,
    Q: int,
    null_width_u: float,
    device,
) -> Tuple[torch.Tensor, torch.Tensor]:
    """
    Build PGLQ nodes. Subintervals are uniform in u=sin(theta), then mapped back to theta.
    null_width_u is the intended broadened null/spectrum width in u-domain.
    """
    z_np, w_np = np.polynomial.legendre.leggauss(int(Q))
    z = torch.tensor(z_np, device=device, dtype=torch.float32)
    w = torch.tensor(w_np, device=device, dtype=torch.float32)

    dz = float(np.max(np.diff(z_np))) if Q > 1 else 2.0
    interval_width = max(1e-4, 2.0 * float(null_width_u) / max(dz, 1e-6))

    u_left_end = math.sin((float(theta_s_nom_deg) - exclude_deg) * math.pi / 180.0)
    u_right_start = math.sin((float(theta_s_nom_deg) + exclude_deg) * math.pi / 180.0)

    intervals = [(-1.0, max(-1.0, min(1.0, u_left_end))),
                 (max(-1.0, min(1.0, u_right_start)), 1.0)]

    all_theta = []
    all_weight = []
    for ua, ub in intervals:
        if ub <= ua:
            continue
        m = max(1, int(math.ceil((ub - ua) / interval_width)))
        edges = torch.linspace(ua, ub, m + 1, device=device)
        for k in range(m):
            a = edges[k]
            b = edges[k + 1]
            u_nodes = 0.5 * (a + b) + 0.5 * (b - a) * z
            u_nodes = u_nodes.clamp(-1.0 + 1e-6, 1.0 - 1e-6)
            theta_nodes = torch.asin(u_nodes) * 180.0 / math.pi
            weights = 0.5 * (b - a) * w
            all_theta.append(theta_nodes)
            all_weight.append(weights)

    return torch.cat(all_theta), torch.cat(all_weight)


def _capon_reconstruct_weighted(
    Rspec: torch.Tensor,
    Rref: torch.Tensor,
    A: torch.Tensor,
    weights: torch.Tensor,
    rho: float = 1e-3,
) -> torch.Tensor:
    """Weighted reconstruction: sum weight(theta) * P_capon(theta) * a a^H."""
    B, N, _ = Rspec.shape
    device = Rspec.device
    dtype = Rspec.dtype
    I = cplx_eye(N, device, dtype=dtype)[None].expand(B, -1, -1)

    Rl = hermitize(Rspec + rho * I)
    rhs = A.t().unsqueeze(0).expand(B, -1, -1)  # [B,N,G]
    RinvA = torch.linalg.solve(Rl, rhs)
    denom = (A.conj().t().unsqueeze(0) * RinvA).sum(dim=1).real.clamp_min(1e-8)  # [B,G]
    P = 1.0 / denom
    P = P / P.mean(dim=-1, keepdim=True).clamp_min(1e-12)

    Rrec = torch.zeros_like(Rref)
    G = A.shape[0]
    for g in range(G):
        ag = A[g][None, :].expand(B, -1)
        wg = weights[g].to(device=device, dtype=torch.float32)
        Rrec = Rrec + (wg * P[:, g])[:, None, None].to(dtype) * ag[:, :, None] * ag.conj()[:, None, :]
    return _add_noise_floor(Rrec, Rref, rel_floor=1e-2)


@torch.no_grad()
def pglq_incm_weight(
    Rhat: torch.Tensor,
    a_nom: torch.Tensor,
    pos_nom: torch.Tensor,
    theta_s_nom_deg: float,
    exclude_deg: float = 6.0,
    Q: int = 3,
    null_width_u: Optional[float] = None,
    signal_subspace_dim: Optional[int] = None,
    eig_energy_thr: float = 0.90,
    peak_gain: float = 3.0,
    rho: float = 1e-3,
) -> torch.Tensor:
    """
    PGLQ-INCM baseline with peak-retained Capon spectrum broadening.

    - Build signal subspace from principal eigenvectors.
    - Amplify dominant subspace: R_d=(I+gP_s)Rhat(I+gP_s)^H.
    - Apply covariance taper matrix T(m,n)=sin((m-n)Δu)/((m-n)Δu).
    - Reconstruct INCM using piecewise Gauss-Legendre quadrature outside SOI sector.
    """
    B, N, _ = Rhat.shape
    device = Rhat.device
    dtype = Rhat.dtype
    I = cplx_eye(N, device, dtype=dtype)[None].expand(B, -1, -1)

    if null_width_u is None:
        # A practical default close to a 3-dB beamwidth scale in u=sin(theta).
        null_width_u = min(0.35, 1.772 / max(2, N))

    evals, evecs = torch.linalg.eigh(hermitize(Rhat))  # ascending
    idx = torch.argsort(evals, dim=-1, descending=True)
    evecs_desc = torch.gather(evecs, 2, idx[:, None, :].expand(B, N, N))
    evals_desc = torch.gather(evals, 1, idx)

    if signal_subspace_dim is None:
        cs = torch.cumsum(evals_desc.real.clamp_min(0.0), dim=-1)
        total = cs[:, -1:].clamp_min(1e-12)
        L_each = (cs / total >= eig_energy_thr).float().argmax(dim=-1) + 1
        L = int(L_each.float().median().item())
        L = min(max(1, L), N - 1)
    else:
        L = min(max(1, int(signal_subspace_dim)), N - 1)

    Us = evecs_desc[:, :, :L]
    Ps = Us @ Us.conj().transpose(-1, -2)
    Rd = (I + float(peak_gain) * Ps) @ Rhat @ (I + float(peak_gain) * Ps).conj().transpose(-1, -2)
    Rd = hermitize(Rd)

    # Covariance taper matrix T; sinc(x)=sin(x)/x.
    idx_n = torch.arange(N, device=device, dtype=torch.float32)
    diff = idx_n[:, None] - idx_n[None, :]
    x = diff * float(null_width_u)
    T_real = torch.where(torch.abs(x) < 1e-8, torch.ones_like(x), torch.sin(x) / x)
    RT = hermitize(Rd * T_real.to(dtype)[None, :, :])

    theta_nodes, q_weights = _pglq_theta_nodes_weights(
        theta_s_nom_deg=theta_s_nom_deg,
        exclude_deg=exclude_deg,
        Q=Q,
        null_width_u=float(null_width_u),
        device=device,
    )
    A = steering_from_positions(pos_nom, theta_nodes, device, dtype=dtype)
    R_incm = _capon_reconstruct_weighted(RT, Rhat, A, q_weights, rho=rho)

    return mvdr_weight(R_incm, a_nom)


class BlackBoxEigenMLP(nn.Module):
    """
    Data-driven black-box baseline:
    eigen-spectrum tokens -> complex beamforming vector.
    The output is distortionless-normalized with respect to a_nom.
    """
    def __init__(self, N: int, hidden: int = 160, dropout: float = 0.05):
        super().__init__()
        self.N = N
        self.net = nn.Sequential(
            nn.Linear(3 * N, hidden),
            nn.SiLU(),
            nn.Dropout(dropout),
            nn.Linear(hidden, hidden),
            nn.SiLU(),
            nn.Linear(hidden, 2 * N),
        )

    def forward(self, Rhat: torch.Tensor, a_nom: torch.Tensor) -> torch.Tensor:
        B, N, _ = Rhat.shape
        tok = eig_tokens(Rhat).reshape(B, -1)
        y = self.net(tok)
        w = torch.complex(y[:, :N], y[:, N:])
        denom = (torch.conj(w) * a_nom).sum(dim=-1)
        w = w / (torch.conj(denom)[:, None] + 1e-8)
        return w

class GRURNNBeamformer(nn.Module):
    """
    Paper-inspired GRU-RNN beamformer baseline.

    Original paper:
      AoA sequence -> GRU -> linear layer -> complex array weights.
    Here:
      [theta_SOI, theta_J1, theta_J2, theta_J3] -> GRU -> 2N outputs -> complex w.
    The output is distortionless-normalized w.r.t. a_nom so it can be evaluated
    with the same SINR metric as other methods.
    """
    def __init__(
        self,
        N: int,
        theta_s_nom_deg: float,
        theta_js_deg: Tuple[float, float, float],
        hidden_size: int = 512,
        num_layers: int = 4,
        dropout: float = 0.05,
        angle_norm: float = 90.0,
    ):
        super().__init__()
        self.N = N
        self.theta_s_nom_deg = float(theta_s_nom_deg)
        self.theta_js_deg = tuple(float(x) for x in theta_js_deg)
        self.angle_norm = float(angle_norm)

        self.gru = nn.GRU(
            input_size=1,
            hidden_size=hidden_size,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout if num_layers > 1 else 0.0,
        )

        self.fc = nn.Sequential(
            nn.LayerNorm(hidden_size),
            nn.Linear(hidden_size, 2 * N),
        )

    def _make_aoa_seq(self, B: int, device) -> torch.Tensor:
        # [SoI, SoA1, SoA2, SoA3], normalized roughly to [-1, 1]
        angles = torch.tensor(
            [self.theta_s_nom_deg, *self.theta_js_deg],
            device=device,
            dtype=torch.float32,
        )
        seq = angles[None, :, None].expand(B, -1, -1) / self.angle_norm
        return seq

    def forward(self, Rhat: torch.Tensor, a_nom: torch.Tensor) -> torch.Tensor:
        B, N, _ = Rhat.shape
        seq = self._make_aoa_seq(B, Rhat.device)

        h, _ = self.gru(seq)
        z = h[:, -1, :]          # many-to-one: only final GRU output
        y = self.fc(z)           # [B, 2N]

        w = torch.complex(y[:, :N], y[:, N:])

        # stabilize early training: avoid zero vector / zero denominator
        w = w + 1e-3 * a_nom

        # enforce w^H a_nom = 1
        denom = (torch.conj(w) * a_nom).sum(dim=-1)
        w = w / (torch.conj(denom)[:, None] + 1e-8)

        return w
def train_blackbox_model(
    model: nn.Module,
    cfg: SimCfg,
    device,
    epochs: int,
    steps_per_epoch: int,
    batch_size: int,
    L_choices: Tuple[int, ...],
    snr_range: Tuple[float, float],
    error_choices: Tuple[str, ...] = ("angle", "gain_phase", "position", "random_sv", "combined"),
    array_choices: Tuple[str, ...] = ("ula", "uca", "ccaa"),   # ← 新增
    lr: float = 3e-4,
):
    model.train()
    opt = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)

    for ep in range(1, epochs + 1):
        losses = []
        for _ in range(steps_per_epoch):
            array_type = random.choice(array_choices)  # ← 新增
            L = random.choice(L_choices)
            snr = snr_range[0] + (snr_range[1] - snr_range[0]) * random.random()
            err = random.choice(error_choices)

            batch = gen_scene_batch_revision(cfg, batch_size, L, snr, device, array_type=array_type, error_type=err)
            w = model(batch["Rhat"], batch["a_nom"])
            sinr = sinr_out_db(w, batch["a_true"], batch["Rin_true"], batch["sigma_s2"])
            loss = -sinr.mean()

            opt.zero_grad(set_to_none=True)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            opt.step()
            losses.append(loss.item())

        print(f"BlackBox epoch {ep:03d}/{epochs} | train(-mean SINR dB)={np.mean(losses):.3f}")


def train_model_revision(
    model: nn.Module,
